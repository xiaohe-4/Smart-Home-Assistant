# 数据库：开发默认 SQLite，可切换 PostgreSQL
# SQLite 示例
DATABASE_URL=sqlite:///data/smart_energy.db
# PostgreSQL 示例
# DATABASE_URL=postgresql+psycopg://smart_energy:smart_energy@localhost:5432/smart_energy

APP_NAME=智家能
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Demo 家庭与演示日（与数据生成脚本保持一致）
DEMO_USER_ID=1
DEMO_DATE=2026-08-19
RANDOM_SEED=42

# 电价（元/kWh），用于策略收益估算
PRICE_PEAK=0.72
PRICE_FLAT=0.52
PRICE_VALLEY=0.28
CARBON_KG_PER_KWH=0.525
